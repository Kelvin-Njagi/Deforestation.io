# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text diff=python

# Shell scripts
*.sh text eol=lf

# Config files
*.toml text
*.yml text
*.yaml text
*.json text

# Requirements
requirements.txt text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite3 binary
